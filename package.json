{
  "name": "kalpana-ide",
  "displayName": "Kalpana AI",
  "publisher": "madushaperera",
  "description": "Infinite Context Local Code Assistant powered by Qwen 2.5 Coder & Kalpana RIF by Vijñāna AI",
  "version": "1.1.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maduperera/Kalpana_VSCode_Ext"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kalpana.start",
        "title": "Start Kalpana Engine"
      },
      {
        "command": "kalpana.openView",
        "title": "Kalpana AI: Open Chat View"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kalpana-explorer",
          "title": "Kalpana AI",
          "icon": "media/kalpana_activity_icon.svg"
        }
      ]
    },
    "views": {
      "kalpana-explorer": [
        {
          "type": "webview",
          "id": "kalpanaChatView",
          "name": "Kalpana Infinite Context"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.x"
  }
}
